# ── SamadhanSetu / JanSamadhan backend config ────────────────
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Port the API listens on (the Vite dev server proxies /api here).
PORT=5000
NODE_ENV=development

# MongoDB connection string. Code accepts MONGO_URI or MONGODB_URI.
#   • Local:  mongodb://127.0.0.1:27017/samadhansetu
#   • Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/samadhansetu

# Auth — sign/verify JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d

# Comma-separated allowed CORS origins (frontend URLs).
CLIENT_ORIGIN=http://localhost:5173

# AI keys — optional, reserved for future backend integration (not yet wired).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
