# ── SamadhanSetu backend config ──────────────────────────────
# Copy this file to `.env` and fill in your values.

# MongoDB connection string.
#   • Local:  mongodb://127.0.0.1:27017/samadhansetu
#   • Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/samadhansetu
MONGODB_URI=mongodb://127.0.0.1:27017/samadhansetu

# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins for CORS (frontend URLs).
CLIENT_ORIGIN=http://localhost:5173
